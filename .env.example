# SentinelX Environment Configuration Template

# Global
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (Dedicated databases per microservice on the same instance for local dev)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sentinelx_admin
POSTGRES_PASSWORD=sentinelx_secret_password
AUTH_DB_NAME=sentinelx_auth
INCIDENT_DB_NAME=sentinelx_incident
LOCATION_DB_NAME=sentinelx_location
AUDIT_DB_NAME=sentinelx_audit
ANALYTICS_DB_NAME=sentinelx_analytics

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Apache Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# OpenSearch
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=AdminPassword123!

# Qdrant Vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# AI Service - LLM Classifier (Section 11/12)
# Real Claude API call for incident classification. If unset, ai-service
# transparently falls back to the deterministic keyword classifier (Section 23) —
# the service works either way, this just upgrades classification quality.
# Get a key at https://console.anthropic.com/ and put it in your local .env
# (gitignored) — never commit a real key here.
ANTHROPIC_API_KEY=

# Security / JWT
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Service Internal Ports
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
INCIDENT_SERVICE_PORT=8082
ASSIGNMENT_SERVICE_PORT=8083
LOCATION_SERVICE_PORT=8084
LOCATION_GRPC_PORT=9094
SLA_SERVICE_PORT=8085
SEARCH_SERVICE_PORT=8086
REALTIME_SERVICE_PORT=8087
NOTIFICATION_SERVICE_PORT=8088
ANALYTICS_SERVICE_PORT=8089
AUDIT_SERVICE_PORT=8090
AI_SERVICE_PORT=8000
AI_GRPC_PORT=50051

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
